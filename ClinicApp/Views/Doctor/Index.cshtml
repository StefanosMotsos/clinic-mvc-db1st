@using ClinicApp.Core
@model ClinicApp.Core.PaginatedResult<ClinicApp.DTO.DoctorReadOnlyDTO>

@{
    ViewData["Title"] = "Doctors";
}

<h2 class="mb-4">Doctors</h2>

<form asp-controller="Doctor" asp-action="Index" method="get" class="row mb-4">
    <div class="col-md-2">
        <input type="text" class="form-control" name="filters.Username" placeholder="Username" />
    </div>
    <div class="col-md-2">
        <input type="text" class="form-control" name="filters.Firstname" placeholder="Firstname" />
    </div>
    <div class="col-md-2">
        <input type="text" class="form-control" name="filters.Lastname" placeholder="Lastname" />
    </div>
    <div class="col-md-2">
        <input type="text" class="form-control" name="filters.Specialty" placeholder="Specialty" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
    <div class="col-md-2">
        <a asp-controller="Doctor" asp-action="Index" class="btn btn-secondary w-100">Clear</a>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-primary">
        <tr>
            <th>Username</th>
            <th>Firstname</th>
            <th>Lastname</th>
            <th>Email</th>
            <th>Specialty</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model.Data)
        {
            <tr class="@(doctor.IsDeleted ? "table-secondary text-muted" : "")">
                <td>@doctor.Username</td>
                <td>@doctor.Firstname</td>
                <td>@doctor.Lastname</td>
                <td>@doctor.Email</td>
                <td>@doctor.Specialty</td>
                <td>@(doctor.IsDeleted ? "Inactive" : "Active")</td>
                <td>
                    <a asp-controller="Doctor" asp-action="Details" asp-route-uuid="@doctor.Uuid"
                       class="btn btn-sm btn-info">Details</a>
                    @if (User.IsInRole("ADMIN"))
                    {
                        <form asp-controller="Doctor" asp-action="Delete" asp-route-uuid="@doctor.Uuid"
                              method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure?')">
                                Delete
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @if (Model.PageNumber > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-controller="Doctor" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize">Previous</a>
            </li>
        }
        <li class="page-item disabled">
            <span class="page-link">Page @Model.PageNumber of @Model.TotalPages</span>
        </li>
        @if (Model.PageNumber < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-controller="Doctor" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize">Next</a>
            </li>
        }
    </ul>
</nav>

@if (ViewData["ErrorArray"] is not null)
{
    var errorArray = ViewData["ErrorArray"] as List<Error>;
    if (errorArray != null)
    {
        foreach (var error in errorArray)
        {
            <div class="alert alert-danger">@error.Message</div>
        }
    }
}
